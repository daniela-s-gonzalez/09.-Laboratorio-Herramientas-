{
  "datasets": [
    {
      "name": "ventas_dia_semana",
      "displayName": "Ventas por Día de la Semana",
      "queryLines": [
        "SELECT\n",
        "  dia_semana,\n",
        "  COUNT(*) AS transacciones,\n",
        "  ROUND(SUM(total), 0) AS total_ventas\n",
        "FROM\n",
        "  workspace.panaderia.ventas\n",
        "GROUP BY\n",
        "  dia_semana\n",
        "ORDER BY\n",
        "  total_ventas DESC"
      ]
    },
    {
      "name": "ventas_sucursal",
      "displayName": "Ventas por Sucursal",
      "queryLines": [
        "SELECT\n",
        "  s.nombre AS sucursal,\n",
        "  COUNT(v.venta_id) AS transacciones,\n",
        "  ROUND(SUM(v.total), 0) AS total_ventas\n",
        "FROM\n",
        "  workspace.panaderia.ventas v\n",
        "    JOIN workspace.panaderia.sucursales s\n",
        "      ON v.sucursal_id = s.sucursal_id\n",
        "GROUP BY\n",
        "  s.nombre\n",
        "ORDER BY\n",
        "  total_ventas DESC"
      ]
    },
    {
      "name": "kpis_principales",
      "displayName": "KPIs Principales",
      "queryLines": [
        "SELECT\n",
        "  COUNT(*) AS total_transacciones,\n",
        "  ROUND(SUM(total), 0) AS total_facturacion,\n",
        "  ROUND(AVG(total), 0) AS ticket_promedio,\n",
        "  COUNT(DISTINCT cliente_id) AS clientes_unicos\n",
        "FROM\n",
        "  workspace.panaderia.ventas"
      ]
    },
    {
      "name": "top_productos",
      "displayName": "Top 10 Productos",
      "queryLines": [
        "SELECT\n",
        "  p.nombre AS producto,\n",
        "  p.categoria,\n",
        "  SUM(d.cantidad) AS unidades_vendidas,\n",
        "  ROUND(SUM(d.subtotal), 0) AS ingresos\n",
        "FROM\n",
        "  workspace.panaderia.detalles_ventas d\n",
        "    JOIN workspace.panaderia.productos p\n",
        "      ON d.producto_id = p.producto_id\n",
        "GROUP BY\n",
        "  p.nombre,\n",
        "  p.categoria\n",
        "ORDER BY\n",
        "  unidades_vendidas DESC\n",
        "LIMIT 10"
      ]
    },
    {
      "name": "ventas_mensuales",
      "displayName": "Ventas Mensuales",
      "queryLines": [
        "SELECT\n",
        "  DATE_FORMAT(fecha, 'yyyy-MM') AS mes,\n",
        "  COUNT(*) AS transacciones,\n",
        "  ROUND(SUM(total), 0) AS total_ventas\n",
        "FROM\n",
        "  workspace.panaderia.ventas\n",
        "GROUP BY\n",
        "  DATE_FORMAT(fecha, 'yyyy-MM')\n",
        "ORDER BY\n",
        "  mes"
      ]
    },
    {
      "name": "ingresos_categoria",
      "displayName": "Ingresos por Categoría",
      "queryLines": [
        "SELECT\n",
        "  p.categoria,\n",
        "  SUM(d.cantidad) AS unidades_vendidas,\n",
        "  ROUND(SUM(d.subtotal), 0) AS ingresos\n",
        "FROM\n",
        "  workspace.panaderia.detalles_ventas d\n",
        "    JOIN workspace.panaderia.productos p\n",
        "      ON d.producto_id = p.producto_id\n",
        "GROUP BY\n",
        "  p.categoria\n",
        "ORDER BY\n",
        "  ingresos DESC"
      ]
    }
  ],
